#!/usr/bin/env bash
# rings — a template for autonomous agent loops.
# https://github.com/Arephan/rings
set -uo pipefail

RINGS_VERSION="0.3.0"
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
RINGS_HOME="${RINGS_HOME:-$HOME/.rings}"

# shellcheck source=../lib/ring.sh
. "$SELF/lib/ring.sh"
# shellcheck source=../lib/contracts.sh
. "$SELF/lib/contracts.sh"

usage() {
  cat <<'EOF'
rings — one ring is one agent loop: trigger, goal, verifier, stop, memory.

  rings new <name>            scaffold a ring in $RINGS_HOME
  rings run <name>            run a ring once, right now
  rings list [--json]         every ring, its schedule, its last verdict
  rings status [name]         detail for one ring, or all of them
  rings doctor [--json]       find dead, silent, runaway and unbounded rings
  rings halt <name> [reason]  stop a ring without touching its schedule
  rings resume <name>         let it run again
  rings install <name>        register its trigger (launchd / systemd / cron)
  rings uninstall <name>      unregister the trigger, keep the ring
  rings logs <name> [n]       tail the ring log
  rings chain                 the dependency graph across rings
  rings contracts [--json]    every declared handoff, and whether it is real
  rings goals [--json]        every ring under the outcome it serves, and the funnel
  rings emit <ring> <type> key=<k> [cause=<id>] [ref=<r>] --file <payload>
                              publish a work item from a script or by hand
  rings retry <id> [<ring>]   dead → ready with attempts reset; or hand an item to a ring
  rings inbox <ring>          what has been handed to a ring, and its state
  rings handoffs [--json]     per type: items, ready, leased, accepted, rejected, dead
  rings trace <id> [--json]   one item's whole life, source to outcome
  rings feed [n] [--json]     the newest n events across the fleet (default 50)
  rings board [port]          serve the read-only board on localhost (default 7781)
  rings demo                  three rings, one fact, one outcome — in an empty RINGS_HOME
  rings version

Rings live in $RINGS_HOME (override with RINGS_HOME). A ring is a directory
with a ring.conf and a RUNBOOK.md; everything else is optional. The fleet's own
file is $RINGS_HOME/rings.conf: the outcome all of this is supposed to add up to.
EOF
}

die() { echo "rings: $*" >&2; exit 1; }

ring_dir_for() {
  local n="$1"
  if [ -d "$n" ] && [ -f "$n/ring.conf" ]; then (cd "$n" && pwd); return 0; fi
  if [ -d "$RINGS_HOME/$n" ]; then echo "$RINGS_HOME/$n"; return 0; fi
  return 1
}

# --- new ---------------------------------------------------------------------

cmd_new() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings new <name>"
  local dir="$RINGS_HOME/$name"
  [ -e "$dir" ] && die "$dir already exists"
  mkdir -p "$dir/hooks" "$dir/out"
  sed "s/__NAME__/$name/g" "$SELF/template/ring.conf" > "$dir/ring.conf"
  sed "s/__NAME__/$name/g" "$SELF/template/RUNBOOK.md" > "$dir/RUNBOOK.md"
  cp "$SELF/template/hooks/verify.sh" "$dir/hooks/verify.sh"
  chmod +x "$dir/hooks/verify.sh"
  cat > "$dir/.gitignore" <<'EOF'
*.log
.lock/
.prev/
.guard.err
.prompt
in/
EOF
  if [ ! -f "$RINGS_HOME/rings.conf" ]; then
    sed 's/__APEX__/the one outcome every ring here is for/' "$SELF/template/rings.conf" \
      > "$RINGS_HOME/rings.conf"
    echo "created $RINGS_HOME/rings.conf — say what the fleet is for before it grows"
  fi
  echo "created $dir"
  echo
  echo "next:"
  echo "  1. write the contract      \$EDITOR $dir/RUNBOOK.md"
  echo "  2. set AGENT and SCHEDULE  \$EDITOR $dir/ring.conf"
  echo "  3. run it once by hand     rings run $name"
  echo "  4. only then schedule it   rings install $name"
}

# --- run ---------------------------------------------------------------------

cmd_run() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings run <name>"
  local dir
  dir=$(ring_dir_for "$name") || die "no ring named $name"
  ring_run "$dir"
}

# --- list / status -----------------------------------------------------------

cmd_list() {
  local d n sched verdict when halted json first today runs serves em cs t
  json=0; [ "${1:-}" = "--json" ] && json=1
  today=$(date -u +%F)
  if [ "$json" -eq 1 ]; then
    echo '{'
    printf '  "generated": "%s",\n' "$(ho_now)"
    echo '  "rings": ['
    first=1
  else
    printf '%-16s %-14s %-11s %-22s %s\n' RING SCHEDULE LAST WHEN STATE
  fi
  for d in $(each_ring); do
    n=$(basename "$d")
    sched=$(conf_get "$d" SCHEDULE "")
    verdict=$(last_ledger_field "$d/ledger.jsonl" verdict || echo "")
    when=$(last_ledger_field "$d/ledger.jsonl" ended || echo "")
    halted="active"
    [ -f "$d/.halt" ] && halted="halted"
    [ -d "$d/.lock" ] && halted="running"
    if [ "$json" -eq 1 ]; then
      runs=0
      [ -s "$d/ledger.jsonl" ] && runs=$(grep -c "\"started\": \"$today" "$d/ledger.jsonl" | tr -d ' ')
      serves=$(conf_get "$d" SERVES "")
      em=""; for t in $(ho_ring_types "$d" EMITS); do em="$em${em:+, }$(ho_json_str "$t")"; done
      cs=""; for t in $(ho_ring_types "$d" CONSUMES); do cs="$cs${cs:+, }$(ho_json_str "$t")"; done
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      printf '    {"ring": %s, "schedule": %s, "lastVerdict": %s, "lastEnded": %s, "state": %s, "runsToday": %s, "serves": %s, "emits": [%s], "consumes": [%s]}' \
        "$(ho_json_str "$n")" "$(ho_json_or_null "$sched")" "$(ho_json_or_null "$verdict")" "$(ho_json_or_null "$when")" \
        "$(ho_json_str "$halted")" "${runs:-0}" "$(ho_json_or_null "$serves")" "$em" "$cs"
    else
      printf '%-16s %-14s %-11s %-22s %s\n' "$n" "${sched:--}" "${verdict:-never ran}" "${when:--}" "$halted"
    fi
  done
  if [ "$json" -eq 1 ]; then
    [ "$first" -eq 1 ] || printf '\n'
    echo '  ]'
    echo '}'
  fi
}

cmd_status() {
  local name="${1:-}"
  if [ -z "$name" ]; then cmd_list; return; fi
  local dir
  dir=$(ring_dir_for "$name") || die "no ring named $name"
  echo "ring:        $(basename "$dir")"
  echo "dir:         $dir"
  echo "schedule:    $(conf_get "$dir" SCHEDULE '(none)')"
  echo "agent:       $(conf_get "$dir" AGENT '(unset)')"
  echo "deliverable: $(conf_get "$dir" DELIVERABLE '(none)')"
  echo "timeout:     $(conf_get "$dir" TIMEOUT 900)s"
  echo "budget:      $(conf_get "$dir" MAX_RUNS_PER_DAY 0) runs/day (0 = unlimited)"
  echo "needs:       $(conf_get "$dir" NEEDS '(nothing)')"
  echo "emits:       $(conf_get "$dir" EMITS '(nothing)')"
  echo "consumes:    $(conf_get "$dir" CONSUMES '(nothing)')"
  echo "serves:      $(conf_get "$dir" SERVES '(no stated outcome)')"
  [ -f "$dir/.halt" ] && echo "HALTED:      $(cat "$dir/.halt")"
  [ -d "$dir/.lock" ] && echo "running:     pid $(cat "$dir/.lock/pid" 2>/dev/null)"
  echo
  if [ -s "$dir/ledger.jsonl" ]; then
    echo "last 5 runs:"
    tail -5 "$dir/ledger.jsonl" | sed 's/^/  /'
  else
    echo "no runs recorded yet"
  fi
}

# --- doctor ------------------------------------------------------------------

DOCTOR_FINDINGS=""

doctor_note() {
  # doctor_note <tag> <text> — one finding; rendered as text or json at the end.
  # One finding is one line: newlines and tabs in the text become spaces.
  printf '%s\t%s\n' "$1" "$(printf '%s' "$2" | tr '\n\t\r' '   ')"
} >> "$DOCTOR_FINDINGS"

doctor_interval_seconds() {
  # doctor_interval_seconds <ring dir> — the gap between two scheduled runs, from
  # SCHEDULE; a day when there is no schedule. Approximate on purpose.
  local sched mins hrs nm nh
  sched=$(conf_get "$1" SCHEDULE "")
  [ -n "$sched" ] || { echo 86400; return; }
  mins=$(cron_field_expand "$(echo "$sched" | awk '{print $1}')" 59)
  hrs=$(cron_field_expand "$(echo "$sched" | awk '{print $2}')" 23)
  # shellcheck disable=SC2086
  nm=$(echo $mins | wc -w | tr -d ' '); [ "$nm" -eq 0 ] && nm=60
  # shellcheck disable=SC2086
  nh=$(echo $hrs | wc -w | tr -d ' '); [ "$nh" -eq 0 ] && nh=24
  echo $(( 86400 / (nm * nh) ))
}

cmd_doctor() {
  local d n issues total
  DOCTOR_FINDINGS=$(mktemp); local json=0; [ "${1:-}" = "--json" ] && json=1
  total=0
  for d in $(each_ring); do
    total=$((total + 1))
    n=$(basename "$d")

    # A scheduled ring that has never produced a ledger line is not running at all.
    local sched
    sched=$(conf_get "$d" SCHEDULE "")
    if [ -n "$sched" ] && [ ! -s "$d/ledger.jsonl" ]; then
      doctor_note dead "$n is scheduled ($sched) but has never recorded a run — is the trigger installed?"
    fi

    if [ -s "$d/ledger.jsonl" ]; then
      # Silent total failure: the loop wakes, burns the call, and never verifies.
      local last20 passes runs
      last20=$(tail -20 "$d/ledger.jsonl")
      passes=$(printf '%s\n' "$last20" | grep -c '"verdict": "pass"' | tr -d ' ')
      runs=$(printf '%s\n' "$last20" | grep -c '"ring"' | tr -d ' ')
      if [ "$runs" -ge 5 ] && [ "$passes" -eq 0 ]; then
        doctor_note silent "$n has not passed once in its last $runs runs — it is burning calls for nothing"
      fi

      # Stale: scheduled, but the last run is older than a day.
      local ended age
      ended=$(last_ledger_field "$d/ledger.jsonl" ended || echo "")
      if [ -n "$sched" ] && [ -n "$ended" ]; then
        age=$(( $(date +%s) - $(ring_mtime "$d/ledger.jsonl") ))
        if [ "$age" -gt 86400 ]; then
          doctor_note stale "$n last ran $((age / 3600))h ago but is scheduled $sched"
        fi
      fi
    fi

    # Unbounded log. These are the files that quietly eat a disk.
    if [ -f "$d/ring.log" ]; then
      local kb
      kb=$(( $(wc -c < "$d/ring.log") / 1024 ))
      if [ "$kb" -gt 51200 ]; then
        doctor_note unbounded "$n ring.log is ${kb}KB — rotate it or write less"
      fi
    fi

    # No budget on a frequent schedule is how an agent loop runs up a bill.
    local budget
    budget=$(conf_get "$d" MAX_RUNS_PER_DAY 0)
    if [ "$budget" = "0" ] && [ -n "$sched" ]; then
      doctor_note unbudgeted "$n has no MAX_RUNS_PER_DAY and a live schedule — one hang loop and it runs all day"
    fi

    # No verifier at all means "it exited 0" is your only evidence.
    if [ -z "$(conf_get "$d" DELIVERABLE "")" ] && [ ! -x "$d/hooks/verify.sh" ]; then
      doctor_note unverified "$n declares no DELIVERABLE and has no hooks/verify.sh — nothing can tell you it worked"
    fi

    # A lock older than any plausible run is a corpse holding the door shut.
    if [ -d "$d/.lock" ]; then
      local lage stale
      lage=$(( $(date +%s) - $(ring_mtime "$d/.lock") ))
      stale=$(conf_get "$d" LOCK_STALE 1800)
      if [ "$lage" -gt "$stale" ]; then
        doctor_note stuck "$n holds a lock ${lage}s old (stale after ${stale}s) — next run will reclaim it"
      fi
    fi

    # A ring halted and forgotten is a ring you think is working.
    if [ -f "$d/.halt" ]; then
      doctor_note halted "$n is halted: $(head -c 120 "$d/.halt")"
    fi
  done

  # Contracts are checked across the fleet, not per ring: the failure is always
  # between two rings, and neither of them can see it alone.
  local scan dangling
  scan=$(contracts_scan)
  while IFS="$(printf '\t')" read -r pr em carrier rel fmt ttl present age rows dec wir cons str st why; do
    [ -n "$pr" ] || continue
    [ "$st" = "flowing" ] && continue
    doctor_note "$st" "$pr.$em — $why"
  done <<SCAN
$scan
SCAN
  dangling=$(contracts_dangling)
  while IFS="$(printf '\t')" read -r cn ref; do
    [ -n "$cn" ] || continue
    doctor_note dangling "$cn consumes $ref, which no ring emits"
  done <<DANG
$dangling
DANG

  # Handoffs: the spool is checked across the fleet, like contracts.
  local items dels chain t sink outcome cnt ready leased acc rej dead oldest gated
  local ring_name ddir f state created ts age limit nd ids since m id ninv nrc
  local now cutoff spool subs cand declared
  items=$(ho_scan_items)
  dels=$(ho_scan_deliveries)
  # ho_chain_types re-reads rings.conf in a subshell per sink; read it once.
  chain=$(ho_chain_types)
  for t in $(printf '%s\n' "$chain" | cut -f1); do
    IFS="$(printf '\t')" read -r t sink outcome cnt ready leased acc rej dead oldest gated <<SUM
$(ho_type_summary "$t" "$items" "$dels" "$chain")
SUM
    [ "$gated" = "0" ] && doctor_note ungated "$t has no types/$t/accept.sh — its items are accepted on the producer's word"
    # An outcome is the end of its chain: nothing consumes it, the funnel does.
    if [ "$outcome" != "1" ] && [ -n "$(ho_producers_of "$t")" ] && [ -z "$(ho_subscribers_of "$t")" ]; then
      doctor_note orphan "$t is emitted and no ring consumes it"
    fi
  done
  now=$(date +%s)
  # $chain already holds every declared type; testing against it beats a
  # re-derive (a fork per type) for each ring's CONSUMES/EMITS.
  declared=" $(printf '%s\n' "$chain" | cut -f1 | tr '\n' ' ') "
  for d in $(each_ring); do
    ring_name=$(basename "$d")
    for t in $(ho_ring_types "$d" CONSUMES) $(ho_ring_types "$d" EMITS); do
      case "$declared" in
        *" $t "*) ;;
        *) doctor_note dangling "$ring_name names $t, which no CHAIN_ line in rings.conf declares" ;;
      esac
    done
    ddir="$(ho_spool)/deliveries/$ring_name"
    [ -d "$ddir" ] || continue
    nd=0; ids=""
    limit=$(( $(doctor_interval_seconds "$d") * 3 ))
    # RFC3339 UTC strings sort as time, so one conversion of the cutoff answers
    # "older than three intervals" for every record. Converting each record's
    # created= instead is a date(1) per ready item.
    cutoff=$(ho_epoch_to_iso $(( now - limit )))
    # The spool was already read once, into $dels; reading each record again here
    # is what made doctor wait on a fork per field.
    while IFS="$(printf '\t')" read -r _ id _ _ state _ created _ _; do
      [ -n "$id" ] || continue
      if [ "$state" = "dead" ]; then nd=$((nd + 1)); ids="$ids $id"; fi
      if [ "$state" = "ready" ] && [ -n "$cutoff" ]; then
        case "$created" in
          [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*Z) ;;
          *)
            doctor_note backlog "$ring_name has a delivery record with an unreadable created= (id $id) — repair or rings retry it"
            continue ;;
        esac
        if [ "$created" \< "$cutoff" ]; then
          age=$(( now - $(ho_iso_to_epoch "$created") ))
          doctor_note backlog "$ring_name has had $id ready for $((age / 3600))h — more than three of its intervals"
        fi
      fi
    done <<RING_DELS
$(printf '%s\n' "$dels" | awk -F'\t' -v r="$ring_name" '$1 == r')
RING_DELS
    [ "$nd" -gt 0 ] && doctor_note dead-letter "$ring_name dropped $nd item(s):$ids — rings retry <id> $ring_name"
    if [ -d "$d/runs" ]; then
      ninv=0; nrc=0
      # shellcheck disable=SC2012
      for f in $(ls -t "$d/runs"/*.receipt 2>/dev/null | head -20); do
        nrc=$((nrc + 1))
        ninv=$(( ninv + $(grep -c '^invalid=' "$f") ))
      done
      [ "$ninv" -gt 0 ] && doctor_note invalid "$ring_name: $ninv refused candidate(s) or decision(s) in its last $nrc receipt(s) — read $d/runs/"
    fi
  done
  # undelivered: an item a subscriber should have a record for, and does not.
  # The subscribers of a type and the marker that says when each started
  # consuming it are the same for every item of that type: read them once per
  # type, not once per item, then let awk pair them with the items.
  spool=$(ho_spool)
  subs=""
  for t in $(printf '%s\n' "$items" | cut -f2 | sort -u); do
    [ -n "$t" ] || continue
    for ring_name in $(ho_subscribers_of "$t"); do
      since="$spool/deliveries/$ring_name/.since.$t"
      [ -f "$since" ] || continue
      subs="$subs$(printf '%s\t%s\t%s' "$t" "$ring_name" "$(cat "$since")")
"
    done
  done
  cand=$(printf '%s\n' "$items" | HO_SUBS_TSV="$subs" awk -F'\t' '
    BEGIN {
      n = split(ENVIRON["HO_SUBS_TSV"], rows, "\n")
      for (i = 1; i <= n; i++) {
        if (rows[i] == "") continue
        split(rows[i], c, "\t")
        nsub[c[1]]++
        sring[c[1], nsub[c[1]]] = c[2]
        ssince[c[1], nsub[c[1]]] = c[3]
      }
    }
    $1 != "" {
      for (i = 1; i <= nsub[$2]; i++) {
        if ($5 < ssince[$2, i]) continue
        printf "%s\t%s\t%s\n", $1, $2, sring[$2, i]
      }
    }')
  while IFS="$(printf '\t')" read -r id t ring_name; do
    [ -n "$id" ] || continue
    [ -f "$spool/deliveries/$ring_name/$id" ] || doctor_note undelivered "$id ($t) has no delivery record at $ring_name — its next run reconciles it"
  done <<ITEMS
$cand
ITEMS

  issues=$(grep -c . "$DOCTOR_FINDINGS" 2>/dev/null | tr -d ' ')
  if [ "$json" -eq 1 ]; then
    local first tag text
    echo '{'
    printf '  "generated": "%s",\n' "$(ho_now)"
    printf '  "rings": %s,\n' "$total"
    echo '  "findings": ['
    first=1
    while IFS="$(printf '\t')" read -r tag text; do
      [ -n "$tag" ] || continue
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      printf '    {"tag": %s, "text": %s}' "$(ho_json_str "$tag")" "$(ho_json_str "$text")"
    done < "$DOCTOR_FINDINGS"
    [ "$first" -eq 1 ] || printf '\n'
    echo '  ]'
    echo '}'
  else
    while IFS="$(printf '\t')" read -r tag text; do
      [ -n "$tag" ] || continue
      printf '%-13s%s\n' "[$tag]" "$text"
    done < "$DOCTOR_FINDINGS"
    echo
    if [ "$issues" -eq 0 ]; then
      echo "$total ring(s), nothing to report."
    else
      echo "$total ring(s), $issues finding(s)."
    fi
  fi
  rm -f "$DOCTOR_FINDINGS"
}

# --- halt / resume -----------------------------------------------------------

cmd_halt() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings halt <name> [reason]"
  local dir
  dir=$(ring_dir_for "$name") || die "no ring named $name"
  shift
  printf '%s %s\n' "$(date -u +%FT%TZ)" "${*:-halted by hand}" > "$dir/.halt"
  echo "halted $name — it will skip every run until: rings resume $name"
}

cmd_resume() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings resume <name>"
  local dir
  dir=$(ring_dir_for "$name") || die "no ring named $name"
  rm -f -- "$dir/.halt"
  echo "resumed $name"
}

# --- install / uninstall -----------------------------------------------------

cron_field_expand() {
  # cron_field_expand <field> <max> — turns a cron field into a space-separated list.
  # Handles *, */N, a-b, a-b/N and comma lists. Prints nothing for a bare *, which
  # the caller reads as "every one of these, so omit the key entirely".
  local field max part step lo hi i out
  field="$1"; max="$2"; out=""
  [ "$field" = "*" ] && return 0
  for part in $(echo "$field" | tr ',' ' '); do
    step=1
    case "$part" in
      */*) step=${part#*/}; part=${part%/*} ;;
    esac
    case "$part" in
      \*)  lo=0; hi="$max" ;;
      *-*) lo=${part%-*}; hi=${part#*-} ;;
      *)   lo="$part"; hi="$part" ;;
    esac
    i="$lo"
    while [ "$i" -le "$hi" ]; do
      out="$out $i"
      i=$((i + step))
    done
  done
  echo "$out"
}

cron_to_launchd() {
  # cron_to_launchd "<min> <hour> <dom> <mon> <dow>" — emits StartCalendarInterval dicts.
  local min hr dom mon dow mins hrs dows m h w
  min=$(echo "$1" | awk '{print $1}')
  hr=$(echo "$1" | awk '{print $2}')
  dom=$(echo "$1" | awk '{print $3}')
  mon=$(echo "$1" | awk '{print $4}')
  dow=$(echo "$1" | awk '{print $5}')
  [ "$dom" = "*" ] || echo "		<!-- day-of-month $dom is not translated; edit this by hand -->"
  [ "$mon" = "*" ] || echo "		<!-- month $mon is not translated; edit this by hand -->"

  mins=$(cron_field_expand "$min" 59)
  hrs=$(cron_field_expand "$hr" 23)
  dows=$(cron_field_expand "$dow" 6)
  # A bare * in the minute field would mean 60 launchd entries per hour, which is
  # never what anyone wants from an agent loop.
  [ -z "$mins" ] && { echo "		<!-- '*' in the minute field means every minute; refusing to expand -->"; return 1; }

  for m in $mins; do
    for h in ${hrs:-_}; do
      for w in ${dows:-_}; do
        printf '\t\t<dict><key>Minute</key><integer>%s</integer>' "$m"
        [ "$h" = "_" ] || printf '<key>Hour</key><integer>%s</integer>' "$h"
        [ "$w" = "_" ] || printf '<key>Weekday</key><integer>%s</integer>' "$w"
        printf '</dict>\n'
      done
    done
  done
}

cmd_install() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings install <name>"
  local dir sched label
  dir=$(ring_dir_for "$name") || die "no ring named $name"
  sched=$(conf_get "$dir" SCHEDULE "")
  [ -n "$sched" ] || die "$name has no SCHEDULE in ring.conf"
  label="rings.$name"

  case "$(uname -s)" in
    Darwin)
      local plist
      plist="$HOME/Library/LaunchAgents/$label.plist"
      {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        echo '<plist version="1.0">'
        echo '<dict>'
        printf '\t<key>Label</key><string>%s</string>\n' "$label"
        echo '	<key>ProgramArguments</key>'
        echo '	<array>'
        printf '\t\t<string>/bin/bash</string>\n'
        printf '\t\t<string>%s/bin/rings</string>\n' "$SELF"
        printf '\t\t<string>run</string>\n'
        printf '\t\t<string>%s</string>\n' "$name"
        echo '	</array>'
        echo '	<key>RunAtLoad</key><false/>'
        printf '\t<key>WorkingDirectory</key><string>%s</string>\n' "$dir"
        printf '\t<key>StandardOutPath</key><string>%s/launchd.log</string>\n' "$dir"
        printf '\t<key>StandardErrorPath</key><string>%s/launchd.log</string>\n' "$dir"
        echo '	<key>StartCalendarInterval</key>'
        echo '	<array>'
        cron_to_launchd "$sched"
        echo '	</array>'
        echo '</dict>'
        echo '</plist>'
      } > "$plist"
      launchctl unload "$plist" 2>/dev/null
      launchctl load "$plist" || die "launchctl load failed"
      echo "installed $label -> $plist"
      ;;
    Linux)
      local unitdir svc tmr oncal
      unitdir="$HOME/.config/systemd/user"
      mkdir -p "$unitdir"
      svc="$unitdir/$label.service"
      tmr="$unitdir/$label.timer"
      oncal=$(conf_get "$dir" ONCALENDAR "")
      [ -n "$oncal" ] || die "on Linux set ONCALENDAR in ring.conf (systemd syntax, e.g. '*:17,47')"
      cat > "$svc" <<EOF
[Unit]
Description=rings: $name

[Service]
Type=oneshot
WorkingDirectory=$dir
ExecStart=/usr/bin/env bash $SELF/bin/rings run $name
EOF
      cat > "$tmr" <<EOF
[Unit]
Description=rings timer: $name

[Timer]
OnCalendar=$oncal
Persistent=true

[Install]
WantedBy=timers.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now "$label.timer" || die "systemctl enable failed"
      echo "installed $label.timer -> $tmr"
      ;;
    *)
      echo "unsupported platform for automatic install. Add this crontab line yourself:"
      echo "$sched $SELF/bin/rings run $name >> $dir/cron.log 2>&1"
      ;;
  esac
}

cmd_uninstall() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings uninstall <name>"
  local label="rings.$name"
  case "$(uname -s)" in
    Darwin)
      local plist="$HOME/Library/LaunchAgents/$label.plist"
      [ -f "$plist" ] || die "$plist not found"
      launchctl unload "$plist" 2>/dev/null
      rm -f -- "$plist"
      echo "uninstalled $label"
      ;;
    Linux)
      systemctl --user disable --now "$label.timer" 2>/dev/null
      rm -f -- "$HOME/.config/systemd/user/$label.timer" "$HOME/.config/systemd/user/$label.service"
      systemctl --user daemon-reload
      echo "uninstalled $label"
      ;;
    *)
      echo "remove the crontab line for $name yourself"
      ;;
  esac
}

# --- logs / chain ------------------------------------------------------------

cmd_logs() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: rings logs <name> [lines]"
  local dir
  dir=$(ring_dir_for "$name") || die "no ring named $name"
  tail -n "${2:-40}" "$dir/ring.log" 2>/dev/null || echo "(no log yet)"
}

cmd_chain() {
  local d n needs dep
  echo "chain (a ring lists what it NEEDS; nothing here runs another ring directly)"
  echo
  for d in $(each_ring); do
    n=$(basename "$d")
    needs=$(conf_get "$d" NEEDS "")
    if [ -z "$needs" ]; then
      echo "  $n  (head of a chain)"
    else
      for dep in $needs; do
        echo "  $dep  feeds  $n"
      done
    fi
  done
  echo
  echo "A chain is data, not control flow: an upstream ring writes its deliverable,"
  echo "a downstream ring reads it and skips when it is stale. Nothing orchestrates."
}

# --- contracts / goals -------------------------------------------------------

json_bool() { if [ "$1" = "1" ]; then echo true; else echo false; fi; }
json_num()  { if [ "$1" = "-" ]; then echo null; else echo "$1"; fi; }

cmd_contracts() {
  local scan dangling total broken first dang
  scan=$(contracts_scan)
  dangling=$(contracts_dangling)
  total=0
  broken=0

  if [ "${1:-}" = "--json" ]; then
    echo '{'
    printf '  "generated": "%s",\n' "$(date -u +%FT%TZ)"
    printf '  "apex": "%s",\n' "$(ring_json_escape "$(fleet_get APEX '')")"
    echo '  "contracts": ['
    first=1
    while IFS="$(printf '\t')" read -r pr em carrier rel fmt ttl present age rows dec wir cons str st why; do
      [ -n "$pr" ] || continue
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      printf '    {"id": "%s.%s", "from": "%s", "carrier": "%s", "format": "%s", "ttlHours": %s, ' \
        "$pr" "$em" "$pr" "$rel" "$fmt" "$ttl"
      printf '"present": %s, "ageSeconds": %s, "rows": %s, "declared": %s, "wired": %s, ' \
        "$(json_bool "$present")" "$age" "$(json_num "$rows")" "$dec" "$wir"
      printf '"consumers": "%s", "stranded": %s, "status": "%s", "why": "%s"}' \
        "$cons" "$str" "$st" "$(ring_json_escape "$why")"
    done <<SCAN
$scan
SCAN
    [ "$first" -eq 1 ] || printf '\n'
    echo '  ]'
    echo '}'
    return 0
  fi

  printf '%-24s %-32s %-9s %s\n' CONTRACT CARRIER STATUS CONSUMERS
  while IFS="$(printf '\t')" read -r pr em carrier rel fmt ttl present age rows dec wir cons str st why; do
    [ -n "$pr" ] || continue
    total=$((total + 1))
    [ "$st" = "flowing" ] || broken=$((broken + 1))
    printf '%-24s %-32s %-9s %s\n' "$pr.$em" "$pr/$rel" "$st" "$cons"
  done <<SCAN
$scan
SCAN

  if [ "$total" -eq 0 ]; then
    echo
    echo "No ring declares EMITS. A contract is two lines of ring.conf:"
    echo '  EMITS="findings:out/findings.jsonl:jsonl:72"   # name:path:format:shelf life (h)'
    echo '  CONSUMES="scout.findings:kind=lead"            # in the ring downstream'
    echo
    echo "See docs/contracts.md."
    return 0
  fi

  echo
  while IFS="$(printf '\t')" read -r pr em carrier rel fmt ttl present age rows dec wir cons str st why; do
    [ -n "$pr" ] || continue
    [ "$st" = "flowing" ] && continue
    printf '  %-11s %s — %s\n' "[$st]" "$pr.$em" "$why"
  done <<SCAN
$scan
SCAN

  dang=0
  while IFS="$(printf '\t')" read -r cn ref; do
    [ -n "$cn" ] || continue
    dang=$((dang + 1))
    printf '  %-11s %s consumes %s, which no ring emits\n' "[dangling]" "$cn" "$ref"
  done <<DANG
$dangling
DANG

  echo
  if [ "$broken" -eq 0 ] && [ "$dang" -eq 0 ]; then
    echo "$total contract(s), all flowing."
  else
    if [ "$dang" -gt 0 ]; then
      echo "$total contract(s), $broken not flowing, $dang dangling consume(s)."
    else
      echo "$total contract(s), $broken not flowing."
    fi
  fi
}

cmd_goals() {
  local apex sinks sink id label d n serves hit orphans oldifs json first_s first_t t ct outcome cnt prods p items on_chain chain
  apex=$(fleet_get APEX "")
  sinks=$(fleet_get SINKS "")
  json=0; [ "${1:-}" = "--json" ] && json=1

  if [ -z "$apex" ] && [ -z "$sinks" ]; then
    if [ "$json" -eq 1 ]; then echo '{"apex": null, "sinks": [], "unserved": []}'; return 0; fi
    echo "No $RINGS_HOME/rings.conf — nothing here states what the fleet is for."
    echo
    echo "Write one:"
    echo '  APEX="the one outcome every ring here is for"'
    echo '  SINKS="revenue:Money in, proof:Machine verified"'
    echo '  CHAIN_revenue="tender.discovered@1 bid.submitted@1 contract.signed@1"'
    echo
    echo 'Then put SERVES="revenue" in each ring.conf, or have it EMIT or CONSUME a type on'
    echo "a chain. A ring that serves nothing is a ring you are paying for and cannot justify."
    return 0
  fi

  items=$(ho_scan_items)
  # ho_chain_types re-reads rings.conf in a subshell per sink; read it once.
  chain=$(ho_chain_types)
  # rings on a chain: any ring whose EMITS or CONSUMES names a declared type
  on_chain=""
  for d in $(each_ring); do
    for t in $(ho_ring_types "$d" EMITS) $(ho_ring_types "$d" CONSUMES); do
      if ho_type_declared "$t"; then on_chain="$on_chain $(basename "$d")"; break; fi
    done
  done

  [ "$json" -eq 1 ] && { echo '{'; printf '  "apex": %s,\n' "$(ho_json_or_null "$apex")"; echo '  "sinks": ['; }
  [ "$json" -eq 0 ] && { echo "apex: ${apex:-(unstated)}"; echo; }
  first_s=1
  oldifs="$IFS"
  IFS=","
  for sink in $sinks; do
    IFS="$oldifs"
    sink=$(printf '%s' "$sink" | sed -e 's/^ *//' -e 's/ *$//')
    [ -n "$sink" ] || { IFS=","; continue; }
    # "revenue : Money in" is a sink someone will write. The blanks around the
    # colon belong to neither half.
    id=$(printf '%s' "${sink%%:*}" | sed -e 's/[[:space:]]*$//')
    label=""
    case "$sink" in *:*) label=$(printf '%s' "${sink#*:}" | sed -e 's/^[[:space:]]*//') ;; esac
    if [ "$json" -eq 1 ]; then
      [ "$first_s" -eq 1 ] || printf ',\n'
      first_s=0
      printf '    {"id": %s, "label": %s, "chain": [' "$(ho_json_str "$id")" "$(ho_json_or_null "$label")"
    else
      printf '  %s%s\n' "$id" "${label:+  — $label}"
    fi
    first_t=1
    while IFS="$(printf '\t')" read -r t ct outcome; do
      [ -n "$t" ] && [ "$ct" = "$id" ] || continue
      cnt=$(printf '%s\n' "$items" | awk -F'\t' -v t="$t" '$2 == t' | grep -c .)
      prods=$(ho_producers_of "$t" | tr '\n' ' ' | sed 's/ $//')
      if [ "$json" -eq 1 ]; then
        [ "$first_t" -eq 1 ] || printf ', '
        first_t=0
        local pj=""; for p in $prods; do pj="$pj${pj:+, }$(ho_json_str "$p")"; done
        printf '{"type": %s, "items": %s, "outcome": %s, "producers": [%s]}' "$(ho_json_str "$t")" "$cnt" "$(json_bool "$outcome")" "$pj"
      else
        printf '      %-26s %4s   %s%s\n' "$t" "$cnt" "${prods:-(no producer)}" "$([ "$outcome" = "1" ] && printf '   (outcome)')"
      fi
    done <<CHAIN
$chain
CHAIN
    [ "$json" -eq 1 ] && printf '], "rings": ['
    hit=0
    first_t=1
    for d in $(each_ring); do
      n=$(basename "$d")
      serves=$(conf_get "$d" SERVES "")
      [ "$serves" = "$id" ] || continue
      hit=1
      if [ "$json" -eq 1 ]; then
        [ "$first_t" -eq 1 ] || printf ', '
        first_t=0
        ho_json_str "$n"
      else
        printf '      %-16s %s\n' "$n" "$(conf_get "$d" EMITS '(emits nothing)')"
      fi
    done
    if [ "$json" -eq 1 ]; then
      printf ']}'
    else
      [ "$hit" -eq 0 ] && [ -z "$(fleet_get "CHAIN_$id" "")" ] && echo "      (nothing feeds this)"
      echo
    fi
    IFS=","
  done
  IFS="$oldifs"

  orphans=""
  for d in $(each_ring); do
    n=$(basename "$d")
    serves=$(conf_get "$d" SERVES "")
    hit=0
    IFS=","
    for sink in $sinks; do
      IFS="$oldifs"
      [ "$(printf '%s' "${sink%%:*}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')" = "$serves" ] && hit=1
      IFS=","
    done
    IFS="$oldifs"
    case " $on_chain " in *" $n "*) hit=1 ;; esac
    [ "$hit" -eq 0 ] && orphans="$orphans $n"
  done
  if [ "$json" -eq 1 ]; then
    [ "$first_s" -eq 1 ] || printf '\n'
    echo '  ],'
    printf '  "unserved": ['
    first_t=1
    for n in $orphans; do
      [ "$first_t" -eq 1 ] || printf ', '
      first_t=0
      ho_json_str "$n"
    done
    echo ']'
    echo '}'
    return 0
  fi
  if [ -n "$orphans" ]; then
    echo "  serving no stated outcome:$orphans"
    echo "      Give each a SERVES that names a sink above, put it on a chain, or stop paying for it."
  fi
}

# --- handoffs ----------------------------------------------------------------

cmd_emit() {
  # rings emit <ring> <type> key=<k> [cause=<id>] [ref=<r>] --file <payload>
  local ring="${1:-}" type="${2:-}" key="" cause="" ref="" file="" tok res
  [ -n "$ring" ] && [ -n "$type" ] || die "usage: rings emit <ring> <type> key=<k> [cause=<id>] [ref=<r>] --file <payload>"
  ring_dir_for "$ring" > /dev/null || die "no ring named $ring"
  shift 2
  while [ $# -gt 0 ]; do
    tok="$1"; shift
    case "$tok" in
      key=*)   key=${tok#key=} ;;
      cause=*) cause=${tok#cause=} ;;
      ref=*)   ref=${tok#ref=} ;;
      --file)  file="${1:-}"; shift ;;
      *)       die "unknown argument: $tok" ;;
    esac
  done
  [ -n "$file" ] || die "--file <payload> is required"
  # A refusal is a failure. A script that pipes emit into something else has to
  # be able to tell "published" from "refused" without reading the English.
  res=$(ho_publish "$ring" "cli-$(ho_run_id)" "$type" "$key" "$cause" "$ref" "$file")
  printf '%s\n' "$res"
  case "$res" in ok\ *) ;; *) exit 1 ;; esac
}

cmd_retry() {
  # rings retry <id> [<ring>] — with no ring, every consumer that has the item dead.
  local id="${1:-}" ring="${2:-}" f hit=0
  [ -n "$id" ] || die "usage: rings retry <id> [<ring>]"
  [ -f "$(ho_spool)/items/$id/manifest" ] || die "no item $id"
  if [ -n "$ring" ]; then
    ring_dir_for "$ring" > /dev/null || die "no ring named $ring"
    ho_retry "$id" "$ring"
    return
  fi
  for f in "$(ho_spool)"/deliveries/*/"$id"; do
    [ -f "$f" ] || continue
    [ "$(ho_kv_get "$f" state)" = "dead" ] || continue
    hit=1
    ho_retry "$id" "$(basename "$(dirname "$f")")"
  done
  [ "$hit" -eq 1 ] || echo "nothing dead for $id"
}

cmd_inbox() {
  local ring="${1:-}" dels now created age
  [ -n "$ring" ] || die "usage: rings inbox <ring>"
  ring_dir_for "$ring" > /dev/null || die "no ring named $ring"
  dels=$(ho_scan_deliveries | awk -F'\t' -v r="$ring" '$1 == r')
  if [ -z "$dels" ]; then echo "nothing has been handed to $ring"; return 0; fi
  now=$(date +%s)
  printf '%-30s %-24s %-10s %-9s %-8s %s\n' ID TYPE FROM STATE ATTEMPTS AGE
  while IFS="$(printf '\t')" read -r _ id type from state att created _ _; do
    [ -n "$id" ] || continue
    age=$(( (now - $(ho_iso_to_epoch "$created")) / 60 ))
    printf '%-30s %-24s %-10s %-9s %-8s %sm\n' "$id" "$type" "$from" "$state" "$att" "$age"
  done <<DELS
$dels
DELS
}

cmd_handoffs() {
  local items dels chain t sink outcome n ready leased acc rej dead oldest gated first subs prods s oldest_txt
  items=$(ho_scan_items)
  dels=$(ho_scan_deliveries)
  # ho_chain_types re-reads rings.conf in a subshell per sink; read it once.
  chain=$(ho_chain_types)
  if [ "${1:-}" = "--json" ]; then
    if [ -z "$chain" ]; then
      printf '{\n  "generated": "%s",\n  "types": []\n}\n' "$(ho_now)"
      return 0
    fi
    echo '{'
    printf '  "generated": "%s",\n' "$(ho_now)"
    echo '  "types": ['
    first=1
    for t in $(printf '%s\n' "$chain" | cut -f1); do
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      IFS="$(printf '\t')" read -r t sink outcome n ready leased acc rej dead oldest gated <<SUM
$(ho_type_summary "$t" "$items" "$dels" "$chain")
SUM
      subs=""; for s in $(ho_subscribers_of "$t"); do subs="$subs${subs:+, }$(ho_json_str "$s")"; done
      prods=""; for s in $(ho_producers_of "$t"); do prods="$prods${prods:+, }$(ho_json_str "$s")"; done
      printf '    {"type": %s, "sink": %s, "outcome": %s, "items": %s, "ready": %s, "leased": %s, "accepted": %s, "rejected": %s, "dead": %s, "oldestReadySeconds": %s, "gated": %s, "subscribers": [%s], "producers": [%s]}' \
        "$(ho_json_str "$t")" "$(ho_json_str "$sink")" "$(json_bool "$outcome")" "$n" "$ready" "$leased" "$acc" "$rej" "$dead" "$(json_num "$oldest")" "$(json_bool "$gated")" "$subs" "$prods"
    done
    [ "$first" -eq 1 ] || printf '\n'
    echo '  ]'
    echo '}'
    return 0
  fi
  if [ -z "$chain" ]; then
    echo "No CHAIN_<sink> in $RINGS_HOME/rings.conf — no handoff types are declared."
    echo 'Declare one:  CHAIN_revenue="tender.discovered@1 bid.submitted@1 contract.signed@1"'
    return 0
  fi
  printf '%-26s %-9s %6s %6s %7s %9s %9s %5s  %s\n' TYPE SINK ITEMS READY LEASED ACCEPTED REJECTED DEAD OLDEST-READY
  for t in $(printf '%s\n' "$chain" | cut -f1); do
    IFS="$(printf '\t')" read -r t sink outcome n ready leased acc rej dead oldest gated <<SUM
$(ho_type_summary "$t" "$items" "$dels" "$chain")
SUM
    oldest_txt=""
    [ "$oldest" != "-" ] && oldest_txt="$((oldest / 60))m"
    printf '%-26s %-9s %6s %6s %7s %9s %9s %5s  %s\n' "$t" "$sink" "$n" "$ready" "$leased" "$acc" "$rej" "$dead" "$oldest_txt"
  done
}

# The spool, read once by cmd_trace and filtered by every node of the walk.
TRACE_ITEMS=""
TRACE_DELS=""

trace_json_item() {
  # trace_json_item <id> <depth-direction: up|down|both> — recursive JSON for one item
  local id="$1" dir="$2" m from run type ts key cause ref sha rcpt first c
  m="$(ho_spool)/items/$id/manifest"
  [ -f "$m" ] || { printf 'null'; return; }
  from=$(ho_kv_get "$m" from); run=$(ho_kv_get "$m" run); type=$(ho_kv_get "$m" type)
  ts=$(ho_kv_get "$m" ts); key=$(ho_kv_get "$m" key); cause=$(ho_kv_get "$m" cause); ref=$(ho_kv_get "$m" ref); sha=$(ho_kv_get "$m" sha256)
  rcpt=""; [ -f "$RINGS_HOME/$from/runs/$run.receipt" ] && rcpt="$RINGS_HOME/$from/runs/$run.receipt"
  printf '{"item": {"id": %s, "type": %s, "from": %s, "run": %s, "ts": %s, "key": %s, "cause": %s, "ref": %s, "sha256": %s, "payloadOk": %s}, ' \
    "$(ho_json_str "$id")" "$(ho_json_str "$type")" "$(ho_json_str "$from")" "$(ho_json_str "$run")" "$(ho_json_str "$ts")" \
    "$(ho_json_str "$key")" "$(ho_json_or_null "$cause")" "$(ho_json_or_null "$ref")" "$(ho_json_str "$sha")" \
    "$(json_bool "$([ "$(ho_sha256 "$(ho_spool)/items/$id/payload")" = "$sha" ] && echo 1 || echo 0)")"
  printf '"receipt": %s, "deliveries": [' "$(ho_json_or_null "$rcpt")"
  first=1
  while IFS="$(printf '\t')" read -r ring _ _ _ state att created ended note; do
    [ -n "$ring" ] || continue
    ended=$(ho_dash "$ended"); note=$(ho_dash "$note")
    [ "$first" -eq 1 ] || printf ', '
    first=0
    printf '{"ring": %s, "state": %s, "attempts": %s, "created": %s, "ended": %s, "note": %s}' \
      "$(ho_json_str "$ring")" "$(ho_json_str "$state")" "${att:-0}" "$(ho_json_str "$created")" "$(ho_json_or_null "$ended")" "$(ho_json_or_null "$note")"
  done <<DELS
$(printf '%s\n' "$TRACE_DELS" | awk -F'\t' -v i="$id" '$2 == i')
DELS
  printf '], "cause": '
  if [ -n "$cause" ] && [ "$dir" != "down" ]; then trace_json_item "$cause" up; else printf 'null'; fi
  printf ', "effects": ['
  first=1
  if [ "$dir" != "up" ]; then
    for c in $(printf '%s\n' "$TRACE_ITEMS" | awk -F'\t' -v i="$id" '$7 == i { print $1 }'); do
      [ "$first" -eq 1 ] || printf ', '
      first=0
      trace_json_item "$c" down
    done
  fi
  printf ']}'
}

trace_text_item() {
  # trace_text_item <id> <indent>
  local id="$1" ind="$2" m from run type ts key cause ref rcpt c
  m="$(ho_spool)/items/$id/manifest"
  [ -f "$m" ] || { echo "${ind}(no item $id)"; return; }
  from=$(ho_kv_get "$m" from); run=$(ho_kv_get "$m" run); type=$(ho_kv_get "$m" type)
  ts=$(ho_kv_get "$m" ts); key=$(ho_kv_get "$m" key); cause=$(ho_kv_get "$m" cause); ref=$(ho_kv_get "$m" ref)
  echo "${ind}$id  $type  key=$key${ref:+  ref=$ref}"
  echo "${ind}  published $ts by $from run $run"
  rcpt="$RINGS_HOME/$from/runs/$run.receipt"
  [ -f "$rcpt" ] && echo "${ind}  receipt: $rcpt"
  [ "$(ho_sha256 "$(ho_spool)/items/$id/payload")" = "$(ho_kv_get "$m" sha256)" ] || echo "${ind}  PAYLOAD CHECKSUM DOES NOT MATCH THE MANIFEST"
  while IFS="$(printf '\t')" read -r ring _ _ _ state att created ended note; do
    [ -n "$ring" ] || continue
    ended=$(ho_dash "$ended"); note=$(ho_dash "$note")
    echo "${ind}  -> $ring: $state after $att silent attempt(s)${ended:+ at $ended}${note:+ — $note}"
  done <<DELS
$(printf '%s\n' "$TRACE_DELS" | awk -F'\t' -v i="$id" '$2 == i')
DELS
  for c in $(printf '%s\n' "$TRACE_ITEMS" | awk -F'\t' -v i="$id" '$7 == i { print $1 }'); do
    echo "${ind}  caused:"
    trace_text_item "$c" "${ind}    "
  done
}

cmd_trace() {
  local id="${1:-}" cause m chain
  [ -n "$id" ] || die "usage: rings trace <id> [--json]"
  m="$(ho_spool)/items/$id/manifest"
  [ -f "$m" ] || die "no item $id in $(ho_spool)/items"
  # Read the spool once for the whole walk. Every node of a trace used to rescan
  # it, so a long chain read the same thousands of files over and over.
  TRACE_ITEMS=$(ho_scan_items)
  TRACE_DELS=$(ho_scan_deliveries)
  if [ "${2:-}" = "--json" ]; then trace_json_item "$id" both; echo; return 0; fi
  # walk up to the root first so the text reads source → outcome
  chain="$id"
  cause=$(ho_kv_get "$m" cause)
  while [ -n "$cause" ] && [ -f "$(ho_spool)/items/$cause/manifest" ]; do
    chain="$cause"
    cause=$(ho_kv_get "$(ho_spool)/items/$cause/manifest" cause)
  done
  trace_text_item "$chain" ""
}

cmd_feed() {
  local n="50" json=0 a ev first ts kind ring id type text
  for a in "$@"; do
    # zero is not a count. BSD head reads the whole file for -n 0, so asking for
    # nothing would print everything.
    case "$a" in
      --json) json=1 ;;
      '' | *[!0-9]*) die "usage: rings feed [n] [--json]" ;;
      *) n=$(printf '%s' "$a" | sed -e 's/^0*//'); [ -n "$n" ] || die "usage: rings feed [n] [--json]" ;;
    esac
  done
  ev=$(ho_events | sort -t "$(printf '\t')" -k1,1r | head -n "$n")
  if [ "$json" -eq 1 ]; then
    echo '{'
    printf '  "generated": "%s",\n' "$(ho_now)"
    echo '  "events": ['
    first=1
    while IFS="$(printf '\t')" read -r ts kind ring id type text; do
      [ -n "$ts" ] || continue
      [ "$first" -eq 1 ] || printf ',\n'
      first=0
      printf '    {"ts": %s, "kind": %s, "ring": %s, "id": %s, "type": %s, "text": %s}' \
        "$(ho_json_str "$ts")" "$(ho_json_str "$kind")" "$(ho_json_str "$ring")" "$(ho_json_or_null "$id")" "$(ho_json_or_null "$type")" "$(ho_json_str "$text")"
    done <<EV
$ev
EV
    [ "$first" -eq 1 ] || printf '\n'
    echo '  ]'
    echo '}'
    return 0
  fi
  while IFS="$(printf '\t')" read -r ts kind ring id type text; do
    [ -n "$ts" ] || continue
    printf '%s  %-10s %s\n' "$ts" "$kind" "$text"
  done <<EV
$ev
EV
}

cmd_board() {
  # rings board [port] — serve the read-only board. Needs node 18+; nothing else does.
  local port="${1:-7781}"
  command -v node >/dev/null 2>&1 || die "rings board needs node 18 or newer (https://nodejs.org). Everything it shows is also in: rings list/goals/handoffs/feed/doctor --json"
  case "$port" in *[!0-9]*) die "usage: rings board [port]" ;; esac
  echo "rings board on http://127.0.0.1:$port — Ctrl-C stops it, nothing is left running."
  RINGS_HOME="$RINGS_HOME" RINGS_BIN="$SELF/bin/rings" exec node "$SELF/board/server.mjs" "$port"
}

cmd_demo() {
  # rings demo — copy the three-ring demo into an empty $RINGS_HOME and run it once.
  local r
  # The demo never writes over anything: an empty (or absent) RINGS_HOME only.
  # shellcheck disable=SC2012
  if [ -d "$RINGS_HOME" ] && [ -n "$(ls -A "$RINGS_HOME" 2>/dev/null)" ]; then
    die "$RINGS_HOME is not empty. Try the demo somewhere empty: RINGS_HOME=\$(mktemp -d) rings demo"
  fi
  cp -R "$SELF/examples/handoff-demo/." "$RINGS_HOME/" || die "could not copy the demo into $RINGS_HOME"
  chmod +x "$RINGS_HOME"/*/agent.sh "$RINGS_HOME"/types/*/accept.sh 2>/dev/null
  echo "three rings in $RINGS_HOME: scout → bidder → closer. Running each once."
  for r in scout bidder closer; do
    # A subshell per ring, so each run's EXIT trap fires on its own lock instead
    # of the last one overwriting the two before it.
    if ( ring_run "$RINGS_HOME/$r" ) > /dev/null 2>&1; then
      echo "  $r  pass"
    else
      echo "  $r  did not pass — rings status $r"
    fi
  done
  echo
  cmd_goals
  echo
  cmd_feed 10
  echo
  echo "Next:"
  echo "  rings trace <any id above>   one item, source to outcome"
  echo "  rings doctor                 the demo ships one finding on purpose"
  echo "  rings board                  the same data as a page, re-read every 5 s"
  command -v node >/dev/null 2>&1 || echo "  (rings board needs node 18+; without it, every number above is in the --json flags)"
}

# --- main --------------------------------------------------------------------

mkdir -p "$RINGS_HOME"
cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  new)        cmd_new "$@" ;;
  run)        cmd_run "$@" ;;
  list|ls)    cmd_list "$@" ;;
  status)     cmd_status "$@" ;;
  doctor)     cmd_doctor "$@" ;;
  halt)       cmd_halt "$@" ;;
  resume)     cmd_resume "$@" ;;
  install)    cmd_install "$@" ;;
  uninstall)  cmd_uninstall "$@" ;;
  logs)       cmd_logs "$@" ;;
  chain)      cmd_chain "$@" ;;
  contracts)  cmd_contracts "$@" ;;
  goals)      cmd_goals "$@" ;;
  emit)       cmd_emit "$@" ;;
  retry)      cmd_retry "$@" ;;
  inbox)      cmd_inbox "$@" ;;
  handoffs)   cmd_handoffs "$@" ;;
  trace)      cmd_trace "$@" ;;
  feed)       cmd_feed "$@" ;;
  board)      cmd_board "$@" ;;
  demo)       cmd_demo "$@" ;;
  version|-v|--version) echo "rings $RINGS_VERSION" ;;
  help|-h|--help) usage ;;
  *)          usage; exit 1 ;;
esac
